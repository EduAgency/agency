# Copy to .env and fill in. NEVER commit .env.
ENVIRONMENT=local
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Every origin the browser may call this API from. Next.js falls back to :3001
# (then :3002...) when :3000 is taken by something else, and the resulting
# failure is a CORS error rather than an obvious one - so list the fallbacks.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

DATABASE_URL=postgres://nasuru:nasuru@localhost:5442/nasuru
REDIS_URL=redis://localhost:6390/0

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored gateway secret unreadable. Back it up separately.
FIELD_ENCRYPTION_KEY=

# Used to build links in emails (password reset, email confirmation). Must match
# the port the frontend is actually served on, or every emailed link 404s.
FRONTEND_BASE_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=Nasuru <no-reply@nasuru.com>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

ACCESS_FEE_AMOUNT=5000.00
ACCESS_FEE_CURRENCY=NGN

# Approve payments without contacting a gateway, so the product can be run and
# demonstrated without live Paystack/Flutterwave keys.
#
# This does NOT bypass the payment gate. The mock gateway is an adapter like
# any other: the payment is created, verified and confirmed through the same
# code a real one uses, and access is still granted by a confirmed payment.
#
# It refuses to run unless DJANGO_DEBUG=True and ENVIRONMENT is not
# 'production' - and Django refuses to start if you set it anyway. After
# switching it on:  make mock-payments
PAYMENTS_MOCK_MODE=False

# Document storage - Cloudflare R2. Leave USE_R2=False locally; uploads then
# go to backend/media/.
#
# R2 speaks the S3 API, which is how Django talks to it, but it is not AWS S3:
# it has no ACLs, no regions, and it will not accept an SSE header. Objects are
# encrypted at rest with AES-256 automatically, which is what makes the
# encryption claim on the landing page and in the privacy policy true.
#
# WHERE THE DOCUMENTS PHYSICALLY LIVE is set when you create the bucket, not
# here. This is an NDPR question, not a performance one - passports and
# national identity documents leaving Nigeria is an international transfer that
# has to be disclosed and needs a lawful basis:
#
#   * default jurisdiction - Cloudflare places data automatically, worldwide.
#   * EU jurisdiction      - data stays in the EU. Still a transfer out of
#                            Nigeria, but a single disclosed destination.
#   * A location hint (for example `apac`) biases initial placement only.
#
# Pick deliberately, then make sure the privacy policy's sub-processor table
# says the same thing.
#
# Credentials come from an R2 API token scoped to this one bucket with Object
# Read & Write - never an account-wide token.
USE_R2=False
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Only set this to override the default https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

SENTRY_DSN=
LOG_LEVEL=INFO
