# Copy to .env and fill in. NEVER commit .env.
ENVIRONMENT=local
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://nasuru:nasuru@localhost:5442/nasuru
REDIS_URL=redis://localhost:6390/0

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored gateway secret unreadable. Back it up separately.
FIELD_ENCRYPTION_KEY=

FRONTEND_BASE_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=Nasuru <no-reply@nasuru.com>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

ACCESS_FEE_AMOUNT=5000.00
ACCESS_FEE_CURRENCY=NGN

# Document storage — leave USE_S3=False locally.
#
# When USE_S3=True the app requests SSE (AES256) on every upload, because the
# landing page and the privacy policy both state that documents are encrypted
# at rest. AWS S3 encrypts by default since January 2023, but S3-compatible
# providers (Backblaze B2, Cloudflare R2, DigitalOcean Spaces, MinIO) vary — so
# the bucket MUST also have a default encryption policy set, and the provider
# must honour the ServerSideEncryption header. Verify this against your
# provider before launch: it is a published claim, not an internal preference.
#
# AWS_S3_REGION_NAME decides WHERE documents live. The default below is
# eu-west-1 (Ireland) — outside Nigeria, which the NDPR treats as an
# international transfer that must be disclosed in the privacy policy and
# needs a lawful transfer basis. Choose af-south-1 (Cape Town) or a
# Nigeria-resident provider if you would rather not carry that obligation.
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-1
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SENTRY_DSN=
LOG_LEVEL=INFO
