# The Django API origin. Not a Vercel route — the backend runs as a persistent
# service (Render / Railway / Fly), see plan §2.1.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010

# The public site's own canonical origin. Canonical tags, Open Graph URLs, the
# sitemap and every JSON-LD @id are built from this, so a wrong value here
# splits the site's search ranking across two hostnames. Set it to the real
# domain in production; localhost is only correct in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
